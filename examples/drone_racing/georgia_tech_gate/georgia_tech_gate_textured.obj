# UV-mapped Georgia Tech gate. The center has no faces, so it stays open.
o georgia_tech_gate_textured
v -1.25 -0.006 -1.25
v  1.25 -0.006 -1.25
v  1.25 -0.006  1.25
v -1.25 -0.006  1.25
v -0.84 -0.006 -0.85
v  0.83 -0.006 -0.85
v  0.83 -0.006  0.87
v -0.84 -0.006  0.87
v -1.25  0.006 -1.25
v  1.25  0.006 -1.25
v  1.25  0.006  1.25
v -1.25  0.006  1.25
v -0.84  0.006 -0.85
v  0.83  0.006 -0.85
v  0.83  0.006  0.87
v -0.84  0.006  0.87

# Front UVs: image bottom maps to negative Z.
vt 0.000 0.000
vt 1.000 0.000
vt 1.000 1.000
vt 0.000 1.000
vt 0.164 0.160
vt 0.832 0.160
vt 0.832 0.848
vt 0.164 0.848
# Rear UVs are horizontally reversed so its text reads correctly.
vt 1.000 0.000
vt 0.000 0.000
vt 0.000 1.000
vt 1.000 1.000
vt 0.836 0.160
vt 0.168 0.160
vt 0.168 0.848
vt 0.836 0.848

# Front ring.
f 1/1 2/2 6/6
f 1/1 6/6 5/5
f 4/4 8/8 7/7
f 4/4 7/7 3/3
f 1/1 5/5 8/8
f 1/1 8/8 4/4
f 2/2 3/3 7/7
f 2/2 7/7 6/6
# Rear ring.
f 9/9 13/13 14/14
f 9/9 14/14 10/10
f 12/12 11/11 15/15
f 12/12 15/15 16/16
f 9/9 12/12 16/16
f 9/9 16/16 13/13
f 10/10 14/14 15/15
f 10/10 15/15 11/11
# Untextured thickness walls (UVs use nearby border pixels).
f 1/1 9/1 10/2
f 1/1 10/2 2/2
f 2/2 10/2 11/3
f 2/2 11/3 3/3
f 3/3 11/3 12/4
f 3/3 12/4 4/4
